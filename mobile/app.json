{
  "expo": {
    "name": "Playvora",
    "slug": "playvora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/playvora-logo.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/playvora-logo.png",
        "backgroundImage": "./assets/images/playvora-logo.png",
        "monochromeImage": "./assets/images/playvora-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.scorchingsun.playvora"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/playvora-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/playvora-logo.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2b4fd408-571f-4c49-b06e-4e9fe55f179e"
      }
    },
    "owner": "scorchingsun"
  }
}
